# ── JamiiTek WhatsApp Bridge ─────────────────────────────────

PORT=3001

# Django inayopokea jumbe na kutuma majibu
DJANGO_URL=https://jamiitek.com

# Ufunguo mmoja unaotumika pande zote mbili:
#   • Bridge inaukagua kwenye KILA njia (isipokuwa /health)
#   • Django inaukagua kwenye /chatbot/webhook/baileys/
# Lazima ulingane na BRIDGE_API_KEY ya Django.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=

# Supabase — session zinahifadhiwa hapa, si kwenye folda.
# Bila hii, kila deploy inafuta session na inabidi uscan QR upya.
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Connections za pool moja inayoshirikiwa na sessions zote.
# Kumbuka Django inashiriki database ile ile — usiipandishe sana.
PG_POOL_MAX=10

# silent | error | warn | info | debug
BAILEYS_LOG_LEVEL=silent
