# ── Mudandaza environment variables ──────────────────────────────────────
# Copy this file to `.env` for local development, and set the same keys in
# Render under Environment. Never commit the real `.env`.

# Generate a fresh key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Option A — single connection string (Render sets this automatically)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — individual settings (Supabase)
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-database-password
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=5432

FERNET_KEY=QJ38hWF7kaf4OdDb9mzrlz6moAHmgjLsjaKstj_IMZU
DEBUG=False