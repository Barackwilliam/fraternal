# ── JamiiTek — environment variables ─────────────────────────────────────
# Nakili faili hii kuwa `.env` kwa kompyuta yako, na weka keys zile zile
# kwenye Render → Environment. USITUME `.env` halisi kwenye git.

# Kwenye kompyuta yako: True.  Kwenye Render: False (au iachwe bila kuwekwa).
DEBUG=True

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=badilisha-hii-iwe-string-ndefu-ya-nasibu

ALLOWED_HOSTS=.jamiitek.com,jamiitek.onrender.com,127.0.0.1,localhost,.localhost

# ── Database (Supabase pooler) ───────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=nywila-yako-ya-database
DB_HOST=aws-1-eu-north-1.pooler.supabase.com
DB_PORT=5432

# ── Integrations ─────────────────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ONYO: ikipotea, credentials zote za providers hazitasomeka tena milele.
FERNET_KEY=tengeneza-yako-mwenyewe

# python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=tengeneza-yako-mwenyewe

# ── AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Email (Gmail app password) ───────────────────────────────────────────
EMAIL_HOST_USER=info@jamiitek.com
EMAIL_HOST_PASSWORD=
PORTAL_BASE_URL=https://jamiitek.com/portal/

# ── Media ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADCARE_PUB_KEY=
UPLOADCARE_SECRET=

# ── WhatsApp Business ────────────────────────────────────────────────────
WHATSAPP_MASTER_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WILLIAM_WHATSAPP=
WILLIAM_PHONE_NUMBER_ID=

# ── Malipo (chatbot inaonyesha hizi kwa mteja) ───────────────────────────
NMB_ACCOUNT=
NMB_NAME=

# ── Cloudflare Turnstile (hiari — ikiachwa tupu, inazimika yenyewe) ──────
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ── Builder ──────────────────────────────────────────────────────────────
BUILDER_BASE_DOMAIN=jamiitek.com

