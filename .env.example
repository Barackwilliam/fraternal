# ── JamiiTek — environment variables ─────────────────────────────────────
# Nakili faili hii kuwa `.env` kwa kompyuta yako, na weka keys zile zile
# kwenye Render → Environment. USITUME `.env` halisi kwenye git.

# Kwenye kompyuta yako: True.  Kwenye Render: False (au iachwe bila kuwekwa).
DEBUG=True

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=badilisha-hii-iwe-string-ndefu-ya-nasibu

ALLOWED_HOSTS=.jamiitek.com,jamiitek.onrender.com,127.0.0.1,localhost,.localhost

# ── Database (Supabase pooler) ───────────────────────────────────────────
# Njia mbili. Ikiwekwa DATABASE_URL, inatumika badala ya DB_* zote.
# GitHub Actions inatumia DATABASE_URL; Render inatumia DB_*.
# DATABASE_URL=postgresql://user:pass@host:5432/postgres
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=nywila-yako-ya-database
DB_HOST=aws-1-eu-north-1.pooler.supabase.com
DB_PORT=5432

# ── Integrations ─────────────────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ONYO: ikipotea, credentials zote za providers hazitasomeka tena milele.
FERNET_KEY=tengeneza-yako-mwenyewe

# Inalinda /cron/sync/ — HIARI. Kazi za ratiba sasa zinaendeshwa na
# DailyTasksMiddleware; hii ni kwa yeyote anayetaka cron ya nje pia.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_TOKEN=tengeneza-yako-mwenyewe

# Inalinda /tasks/daily/ — kitufe cha kulazimisha kazi zikimbie sasa.
# Bila hii, endpoint inarudisha 503. Kazi za kawaida zinaendelea
# kukimbia kupitia middleware bila kujali token hii.
TASKS_TOKEN=tengeneza-yako-mwenyewe

# ── AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Model ya Groq kwa mfumo mzima. Ikiachwa tupu, inatumia default ya code.
# Bot moja moja inaweza kuizidi kwa BotConfig.ai_model.
GROQ_MODEL=

# ── Email (Gmail app password) ───────────────────────────────────────────
EMAIL_HOST_USER=info@jamiitek.com
EMAIL_HOST_PASSWORD=
PORTAL_BASE_URL=https://jamiitek.com/portal/

# ── Media ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── WhatsApp Business ────────────────────────────────────────────────────
WHATSAPP_MASTER_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WILLIAM_WHATSAPP=
WILLIAM_PHONE_NUMBER_ID=

# ── Email ────────────────────────────────────────────────────────────────
# Render free INAZUIA SMTP ports 25/465/587. Brevo inatuma kupitia HTTPS.
# app.brevo.com > SMTP & API > API Keys
# Sender (EMAIL_HOST_USER) LAZIMA ithibitishwe: Senders > Add a sender.
BREVO_API_KEY=
EMAIL_HOST_USER=info@jamiitek.com

# SMTP — inatumika tu kama BREVO_API_KEY haipo (Render ya kulipia, au dev)
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_TIMEOUT=10

# ── Supabase Storage (image) ─────────────────────────────────────────────
# Project URL, mfano: https://abcdefgh.supabase.co
SUPABASE_URL=
# Funguo ya service_role (Settings > API > service_role).
# SI anon key. Hii haipaswi kufika browser kamwe.
SUPABASE_SERVICE_KEY=
# Jina la bucket. Lazima iwe PUBLIC ili image zionekane kwenye tovuti.
SUPABASE_BUCKET=media

# ── Baileys Bridge (WhatsApp) ────────────────────────────────────────────
# URL ya mchakato wa Node unaoshikilia socket za WhatsApp.
BRIDGE_URL=https://jamiitek-bridge.onrender.com
# Ufunguo mmoja kwa pande zote mbili. LAZIMA ulingane na ule wa bridge.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=

# ── Malipo (chatbot inaonyesha hizi kwa mteja) ───────────────────────────
NMB_ACCOUNT=
NMB_NAME=

# ── Cloudflare Turnstile (hiari — ikiachwa tupu, inazimika yenyewe) ──────
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ── Builder ──────────────────────────────────────────────────────────────
BUILDER_BASE_DOMAIN=jamiitek.com
# Kikomo cha maombi ya AI kwa mtumiaji kwa siku (kuzuia gharama kupanda)
BUILDER_AI_DAILY_LIMIT=
# Muda wa kuhifadhi majibu ya AI (sekunde)
BUILDER_AI_CACHE_TTL=
# True = subdomain inasajiliwa yenyewe site inapoundwa
BUILDER_AUTO_REGISTER_SUBDOMAINS=

# ── Infrastructure dashboard (/manage/infra/) ────────────────────────────
# Kwa kuvuta hali ya deploy ya JamiiTek yenyewe kutoka Render.
# API key: Render → Account Settings → API Keys
RENDER_API_KEY=
# Service ID: iko kwenye URL ya service, inaanza na srv-
RENDER_SERVICE_ID=

# ── Alerts (chagua mojawapo, au zote mbili) ──────────────────────────────
# Telegram — rahisi zaidi kuanzisha
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp kupitia Green API
GREEN_API_ID=
GREEN_API_TOKEN=
GREEN_API_RECIPIENT=

# ── Cache — MUHIMU kwenye production ─────────────────────────────────────
# DailyTasksMiddleware inahifadhi alama za kazi za ratiba hapa (ni nini
# kimeshakimbia na lini). Bila Redis, kila worker wa gunicorn ana
# LocMemCache yake — kazi zitarudiwa mara moja kwa kila worker.
# Kwa dev ya kompyuta yako inaweza kuachwa tupu.
REDIS_URL=
